<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SherioMAUI.Views.CheckOutPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="White"
              Padding="16,50,16,16"
              ColumnDefinitions="Auto,*">
            <Button Text="←"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BackgroundColor="#F1F5F9"
                    TextColor="#111827"
                    Clicked="Back_Click"/>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2">
                <Label Text="תשלום והשלמת הזמנה"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#111827"/>
                <Label Text="בדוק את הפרטים לפני אישור"
                       FontSize="13"
                       TextColor="#6B7280"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18"
                                 Spacing="16">

                <Frame BackgroundColor="White"
                       CornerRadius="20"
                       Padding="16"
                       HasShadow="True"
                       BorderColor="#EEF2F7">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="סיכום הזמנה"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#111827"/>

                        <Label x:Name="HotelSummaryLabel"
                               FontSize="14"
                               TextColor="#475569"/>

                        <Label x:Name="RoomSummaryLabel"
                               FontSize="14"
                               TextColor="#475569"/>

                        <Label x:Name="DatesSummaryLabel"
                               FontSize="14"
                               TextColor="#475569"/>

                        <Label x:Name="GuestsSummaryLabel"
                               FontSize="14"
                               TextColor="#475569"/>

                        <Label x:Name="PriceSummaryLabel"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#2563EB"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White"
                       CornerRadius="20"
                       Padding="16"
                       HasShadow="True"
                       BorderColor="#EEF2F7">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="פרטי תשלום"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#111827"/>

                        <Entry x:Name="CardNameEntry"
                               Placeholder="שם בעל הכרטיס"/>

                        <Entry x:Name="CardNumberEntry"
                               Placeholder="מספר כרטיס"/>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Entry x:Name="ExpiryEntry"
                                   Placeholder="תוקף MM/YY"/>
                            <Entry x:Name="CvvEntry"
                                   Grid.Column="1"
                                   Placeholder="CVV"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="אשר הזמנה"
                        HeightRequest="52"
                        CornerRadius="14"
                        BackgroundColor="#0F172A"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="ConfirmOrder_Click"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>